<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. TDLib's session files never leave the device by either route: a cloud
    backup would put an active Telegram session in a Google account, and device-to-device transfer
    would hand a new phone a session database it cannot legitimately use.

    LumoVault's own database is excluded by both routes too, matching the API 31-and-below rules in
    backup_rules.xml. It is not the settings row an earlier comment claimed: at the current schema it
    holds the whole media index — every file name and relative path on the device — the backup queue
    and the restore rows, which is somebody's photo library described in text and does not belong in
    a Google account. A transferred copy is also a stale one: the session it would reference is
    excluded above, so the new device re-authenticates regardless, and the index rebuilds itself on
    the first scan. Excluding loses setup flags and re-asks them; including would leak the library.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="tdlib_database" />
        <exclude
            domain="file"
            path="tdlib_files" />
        <exclude
            domain="database"
            path="lumovault.db" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="file"
            path="tdlib_database" />
        <exclude
            domain="file"
            path="tdlib_files" />
        <exclude
            domain="database"
            path="lumovault.db" />
    </device-transfer>
</data-extraction-rules>
