<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. TDLib's session and downloaded files stay on the device that created them;
    the settings database is excluded too, because restoring a session reference on another install
    would claim an account that this install cannot actually use.
-->
<full-backup-content>
    <!--
        `getDir("tdlib_database")` creates `app_tdlib_database` under the data directory root, not
        under `files/` — so `domain="root"` is the only domain whose path matches it, and
        `domain="file"` matched nothing at all.
    -->
    <exclude
        domain="root"
        path="app_tdlib_database" />
    <exclude
        domain="root"
        path="app_tdlib_files" />
    <exclude
        domain="database"
        path="lumovault.db" />
</full-backup-content>
