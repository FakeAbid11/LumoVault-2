    <string name="onboarding_telegram_forgot_password">Forgot password?</string>
    <string name="onboarding_telegram_forgot_password_title">Forgot your password?</string>
    <string name="onboarding_telegram_forgot_password_body">This is the two-step verification password set on your Telegram account — not a LumoVault password.\n\nTo reset it, contact Telegram support through the official Telegram app (Settings → Privacy and Security → Two-Step Verification → Forgot password), or via the Telegram website. Resets can take a few days.</string>
