<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Media, notification and battery-optimisation permissions arrive with the phases that
        need them (PRD sections 18, 38) so each one can be requested at the right moment.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backup rules are deferred on purpose: there is nothing sensitive to protect until Phase 2
        stores a Telegram session, and that is when exclusions become meaningful.
    -->
    <application
        android:name=".LumoVaultApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumoVault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
