# Gradle / build outputs
.gradle/
build/
.kotlin/

# IDE
.idea/
*.iml

# Local machine configuration (never committed)
local.properties

# Signing material stays out of the repository
*.jks
*.keystore
*.pk8

# Captured artifacts
captures/
*.apk
*.aab

# TDLib's binaries are fetched by CI from pinned, SHA-256-verified release assets and installed
# here. Committing them would put an unreviewed native library on the path that holds the user's
# Telegram session, which is what the project's supply-chain rule exists to prevent.
app/src/main/jniLibs/
