# Gradle / build outputs
.gradle/
build/
.kotlin/

# IDE
.idea/
*.iml

# Local machine configuration (never committed)
local.properties

# Signing material stays out of the repository
*.jks
*.keystore
*.pk8

# Captured artifacts
captures/
*.apk
*.aab

# TDLib's Java interface and its native library are fetched by CI from the pinned build-tdlib.yml run
# and checked against a pinned SHA-256 before they are used. Committing them would put an unreviewed
# native library on the path that holds the user's Telegram session, and the generated TdApi.java only
# has to agree with that library — which it does only when both come from the same build of one
# revision. Both paths are therefore build inputs, never sources.
app/src/main/jniLibs/
app/src/main/java/org/drinkless/

